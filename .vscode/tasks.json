{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++",
            "type": "process",
            "command": "bash",
            "args": ["${workspaceFolder}/.vscode/build.sh"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}\\.vscode\\build.ps1"
                ]
            }
        },
        {
            "label": "Build & Run",
            "type": "process",
            "command": "bash",
            "args": ["${workspaceFolder}/.vscode/build.sh", "run"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "problemMatcher": ["$gcc"],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy", "Bypass",
                    "-File", "${workspaceFolder}\\.vscode\\build.ps1",
                    "-Run"
                ]
            }
        }
    ]
}